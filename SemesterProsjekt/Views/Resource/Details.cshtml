@model SemesterProsjekt.Models.Resource

@{
    ViewData["Title"] = "Ressursdetaljer";
}

<h1>Ressursdetaljer</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>

        <p class="card-text">
            <strong>Beskrivelse:</strong><br />
            @Model.Description
        </p>

        <p class="card-text">
            <strong>Ressurstype-ID:</strong>
            @Model.ResourceTypeId
        </p>

        <p class="card-text">
            <strong>Mengde:</strong>
            @Model.Quantity @Model.Unit
        </p>

        <p class="card-text">
            <strong>Kontaktpunkt:</strong>
            @(Model.ContactPoint ?? "Ikke oppgitt")
        </p>

        <p class="card-text">
            <strong>Tilgjengelig fra:</strong>
            @(Model.AvailableFrom?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")
        </p>

        <p class="card-text">
            <strong>Tilgjengelig til:</strong>
            @(Model.AvailableTo?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")
        </p>

        <p class="card-text">
            <strong>Status:</strong>
            @Model.Status
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.GeometryType))
        {
            <p class="card-text">
                <strong>Geometri:</strong>
                @Model.GeometryType
            </p>
        }
    </div>
</div>

<a asp-controller="Resource"
   asp-action="Overview"
   class="btn btn-secondary mt-3">
    Tilbake til ressursoversikten
</a>