@model SemesterProsjekt.Models.Resource

@{
    ViewData["Title"] = "Ressursdetaljer";
}

<h1>Ressursdetaljer</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Type</h5>

        <p class="card-text">
            <strong>Beskrivelse:</strong><br />
            @Model.Description
        </p>

        <p class="card-text">
            <strong>Sted:</strong><br />
            @Model.Location
        </p>

        <p class="card-text">
            <strong>Koordinater:</strong><br />
            @Model.Latitude, @Model.Longitude
        </p>
    </div>
</div>

<a asp-controller="Resource"
   asp-action="Overview"
   class="btn btn-secondary mt-3">
    Tilbake til ressursoversikten
</a>
