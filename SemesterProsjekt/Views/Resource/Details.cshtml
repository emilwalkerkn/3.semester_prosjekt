@model SemesterProsjekt.Models.Resource

@{
    ViewData["Title"] = "Ressursdetaljer";
    var canManage = User.IsInRole("Admin") || User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId;
}

<section class="details-page">
    <a asp-action="Overview" class="back-link">← Tilbake til ressurser</a>

    <article class="portal-card details-card">
        <header class="details-heading">
            <div>
                <p class="record-type">@(Model.ResourceTypeName ?? "Ressurs")</p>
                <h1>@Model.Title</h1>
            </div>
            <span class="status available">@Model.Status</span>
        </header>

        <p class="details-description">@Model.Description</p>

        <dl class="details-grid">
            <div><dt>Type</dt><dd>@(Model.ResourceTypeName ?? "Ikke oppgitt")</dd></div>
            <div><dt>Mengde</dt><dd>@Model.Quantity @Model.Unit</dd></div>
            <div><dt>Kontaktpunkt</dt><dd>@(Model.ContactPoint ?? "Ikke oppgitt")</dd></div>
            <div><dt>Tilgjengelig fra</dt><dd>@(Model.AvailableFrom?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")</dd></div>
            <div><dt>Tilgjengelig til</dt><dd>@(Model.AvailableTo?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")</dd></div>
            <div><dt>Status</dt><dd>@Model.Status</dd></div>
        </dl>

        @if (canManage)
        {
            <div class="record-actions details-actions">
                <a asp-action="Edit" asp-route-id="@Model.ResourceId" class="portal-button">Rediger ressurs</a>
                <a asp-action="Delete" asp-route-id="@Model.ResourceId" class="portal-button danger">Slett ressurs</a>
            </div>
        }
    </article>
</section>
