@*
    Dette er oversikten over registrerte ressurser.

    Siden viser:
    - Alle registrerte ressurser
    - Ressursenes plassering på et kart
    - Status, tilgjengelighet og mengde
    - Mulighet for å skrive ut listen
    - Knapper for å vise, redigere og slette
*@

@using System.Text.Json
@model IEnumerable<SemesterProsjekt.Models.Resource>

@{
    // Angir tittelen til siden.
    var ownResourcesOnly = !ResourceVisibility.CanBrowseAll(User);
    var pageTitle = ResourceVisibility.OverviewTitle(User);
    ViewData["Title"] = pageTitle;
    var search = ViewData["Search"] as string;
    var typeId = ViewData["ResourceTypeId"] as int?;
    var statusFilter = ViewData["Status"] as string;
    var countyFilter = Context.Request.Query["county"].ToString();

    var counties = new[]
    {
        "Agder", "Akershus", "Buskerud", "Finnmark", "Innlandet",
        "Møre og Romsdal", "Nordland", "Oslo", "Rogaland",
        "Telemark", "Troms", "Trøndelag", "Vestfold",
        "Vestland", "Østfold"
    };

    /*
        Ressurseiere og administratorer
        kan registrere nye ressurser.
    */
    var canRegister =
        User.IsInRole("Ressurseier") ||
        User.IsInRole("Admin");

    // Henter ID-en til brukeren som er logget inn.
    var currentUserId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier
    )?.Value;

    /*
        Henter kartinformasjon fra ressursene.
        Ressurser uten plassering blir ikke tatt med.
    */
    var mapEntries = Model
        .Where(resource =>
            !string.IsNullOrWhiteSpace(resource.GeometryData))
        .Select(resource => new
        {
            geometryData = resource.GeometryData,
            title = resource.Title,
            status = resource.Status,
            quantity = resource.Quantity,
            unit = resource.Unit,
            time = resource.AvailableFrom?.ToString("dd.MM.yyyy HH:mm"),
            timeLabel = "Tilgjengelig fra",
            detailsUrl = Url.Action("Details", "Resource", new { id = resource.ResourceId }),
            symbol = SemesterProsjekt.Models.PortalTypeIcons.ForResource(resource.ResourceTypeId).Symbol,
            typeLabel = SemesterProsjekt.Models.PortalTypeIcons.ForResource(resource.ResourceTypeId).Label
        });
}

<section class="overview-page split-overview-page">

    @* Overskriften og introduksjonen til siden. *@
    <header class="overview-heading">
        <div>
            <p class="eyebrow">Oversikt</p>
            <h1>@pageTitle</h1>

            <p class="page-intro">
                @(ownResourcesOnly ? "Se og administrer ressursene du selv har registrert." : "Finn ressurser som kan brukes for å løse registrerte behov.")
            </p>
        </div>

        <div class="overview-heading-actions">

            @* Sender brukeren til en utskriftsvennlig side. *@
            <a asp-action="Print"
               asp-route-search="@search"
               asp-route-resourceTypeId="@typeId"
               asp-route-status="@statusFilter"
               asp-route-county="@countyFilter"
               class="portal-button secondary">
                Skriv ut liste
            </a>

            @*
                Knappen vises bare for ressurseiere
                og administratorer.
            *@
            @if (canRegister)
            {
                <a asp-action="Create"
                   class="portal-button">
                    + Registrer ressurs
                </a>
            }
        </div>
    </header>

    <form asp-action="Overview" method="get" class="portal-card resource-search" role="search" aria-label="Søk og filtrer ressurser">
        <div class="form-field resource-search-text">
            <label for="resource-search">Søk i ressurser</label>
            <input id="resource-search" type="search" name="search" value="@search" placeholder="Søk etter tittel, beskrivelse eller type" />
        </div>
        <div class="form-field">
            <label for="resource-type-filter">Ressurstype</label>
            <select id="resource-type-filter" name="resourceTypeId" asp-items="@(ViewData["ResourceTypes"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)">
                <option value="">Alle typer</option>
            </select>
        </div>
        <div class="form-field">
            <label for="resource-status-filter">Status</label>
            <select id="resource-status-filter" name="status">
                <option value="">Alle statuser</option>
                <option value="Available" selected="@(statusFilter == "Available")">Tilgjengelig</option>
                <option value="Unavailable" selected="@(statusFilter == "Unavailable")">Ikke tilgjengelig</option>
            </select>
        </div>
        
        <div class="form-field">
            <label for="resource-county-filter">Fylke</label>
            <select id="resource-county-filter" name="county">
                <option value="">Alle fylker</option>

                @foreach (var county in counties)
                {
                    <option value="@county"
                            selected="@(countyFilter == county)">
                        @county
                    </option>
                }
            </select>
        </div>
        <button type="submit" class="portal-button">Søk og filtrer</button>
        <a asp-action="Overview" class="portal-button secondary">Nullstill</a>
    </form>
    <p class="resource-search-count" role="status">Viser @Model.Count() ressurser. Kartet viser samme utvalg.</p>
    <div class="overview-split">
    @* Viser plasseringen til ressursene på et kart. *@
    <section class="portal-card overview-map-card"
             aria-labelledby="resource-map-heading">

        <div class="section-heading">
            <div>
                <p class="eyebrow">Kart</p>

                <h2 id="resource-map-heading">
                    @pageTitle
                </h2>
            </div>

            @* Viser hvor mange ressurser som finnes. *@
            <span class="overview-count">
                @Model.Count() ressurser
            </span>
        </div>

        <button type="button" class="portal-button secondary overview-fullscreen" aria-controls="resourceMap">Vis kart i fullskjerm</button>
        @* JavaScript bruker dette området til å vise kartet. *@
        <div id="resourceMap"
             class="map-panel"
             aria-label="Kart med registrerte ressurser">
        </div>
    </section>

    @* Listen over registrerte ressurser. *@
    <section class="overview-list"
             aria-label="Liste over ressurser">

        @* Viser en melding dersom listen er tom. *@
        @if (!Model.Any())
        {
            <div class="portal-card empty-state">
                <h2>Ingen ressurser å vise</h2>

                <p>
                    @(search != null || typeId.HasValue || !string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(countyFilter) ? "Ingen ressurser samsvarer med søket. Prøv andre filtre eller nullstill søket." : ownResourcesOnly ? "Du har ikke registrert noen ressurser ennå." : "Nye ressurser dukker opp her når de er registrert.")
                </p>

                @if (canRegister)
                {
                    <a asp-action="Create"
                       class="portal-button">
                        Registrer ressurs
                    </a>
                }
            </div>
        }
        else
        {
            @*
                Går gjennom listen og viser
                ett kort for hver ressurs.
            *@
            @foreach (var resource in Model)
            {
                /*
                    Sjekker om brukeren kan endre ressursen.
                    Administratoren og eieren får tilgang.
                */
                var canManage =
                    User.IsInRole("Admin") ||
                    currentUserId == resource.UserId;

                // Finner riktig symbol for ressurstypen.
                var typeIcon =
                    PortalTypeIcons.ForResource(
                        resource.ResourceTypeId
                    );

                <article class="portal-card overview-record">

                    @* Viser symbol, type, tittel og beskrivelse. *@
                    <div class="overview-record-main">
                        <div class="record-title-with-icon">

                            <span class="type-icon"
                                  role="img"
                                  aria-label="@typeIcon.Label">
                                <img src="@typeIcon.Symbol" alt="" />
                            </span>

                            <div>
                                <p class="record-type">
                                    @(resource.ResourceTypeName ?? "Ressurs")
                                </p>

                                <h2>@resource.Title</h2>
                            </div>
                        </div>

                        <p class="overview-description">
                            @resource.Description
                        </p>
                    </div>

                    @* Viser viktige opplysninger om ressursen. *@
                    <div class="overview-meta">
                        <div>
                            <span>Status</span>
                            <strong>@resource.Status</strong>
                        </div>

                        <div>
                            <span>Tilgjengelig fra</span>

                            <strong>
                                @(resource.AvailableFrom?
                                    .ToString("dd.MM.yyyy HH:mm")
                                  ?? "Ikke oppgitt")
                            </strong>
                        </div>

                        <div>
                            <span>Mengde</span>

                            <strong>
                                @resource.Quantity @resource.Unit
                            </strong>
                        </div>
                    </div>

                    @* Viser status og tilgjengelige handlinger. *@
                    <div class="overview-record-footer">
                        <span class="status available">
                            @resource.Status
                        </span>

                        <div class="record-actions">

                            @* Alle brukere kan se detaljene. *@
                            <a asp-action="Details"
                               asp-route-id="@resource.ResourceId"
                               class="portal-button secondary">
                                Se detaljer
                            </a>

                            @*
                                Rediger og slett vises bare for
                                administratoren eller eieren.
                            *@
                            @if (canManage)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@resource.ResourceId"
                                   class="portal-button secondary">
                                    Rediger
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@resource.ResourceId"
                                   class="portal-button danger">
                                    Slett
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        }
    </section>
    </div>
</section>

@section Scripts {
    @* Henter JavaScript som viser oversiktskartet. *@
    <script src="~/js/overview-map.js"
            asp-append-version="true">
    </script>

    <script>
        /*
            Lager kartet og sender inn plasseringene
            fra modellen som JSON-data.
        */
        PortalOverviewMap.create(
            "resourceMap",
            @Html.Raw(JsonSerializer.Serialize(mapEntries))
        );
    </script>
}
