@using System.Text.Json
@model IEnumerable<SemesterProsjekt.Models.Resource>

@{
    ViewData["Title"] = "Tilgjengelige ressurser";
    var canRegister = User.IsInRole("Ressurseier") || User.IsInRole("Admin");
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var mapEntries = Model
        .Where(resource => !string.IsNullOrWhiteSpace(resource.GeometryData))
        .Select(resource => new { geometryData = resource.GeometryData, title = resource.Title });
}

<section class="overview-page">
    <header class="overview-heading">
        <div>
            <p class="eyebrow">Oversikt</p>
            <h1>Tilgjengelige ressurser</h1>
            <p class="page-intro">Finn ressurser som kan brukes for å løse registrerte behov.</p>
        </div>

        <div class="overview-heading-actions">
            <a asp-action="Print" class="portal-button secondary">Skriv ut liste</a>
            @if (canRegister)
            {
                <a asp-action="Create" class="portal-button">+ Registrer ressurs</a>
            }
        </div>
    </header>

    <section class="portal-card overview-map-card" aria-labelledby="resource-map-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Kart</p>
                <h2 id="resource-map-heading">Registrerte ressurser</h2>
            </div>
            <span class="overview-count">@Model.Count() ressurser</span>
        </div>
        <div id="resourceMap" class="map-panel" aria-label="Kart med registrerte ressurser"></div>
    </section>

    <section class="overview-list" aria-label="Liste over ressurser">
        @if (!Model.Any())
        {
            <div class="portal-card empty-state">
                <h2>Ingen ressurser ennå</h2>
                <p>Nye ressurser dukker opp her når de er registrert.</p>
                @if (canRegister)
                {
                    <a asp-action="Create" class="portal-button">Registrer ressurs</a>
                }
            </div>
        }
        else
        {
            @foreach (var resource in Model)
            {
                var canManage = User.IsInRole("Admin") || currentUserId == resource.UserId;
                var typeIcon = PortalTypeIcons.ForResource(resource.ResourceTypeId);

                <article class="portal-card overview-record">
                    <div class="overview-record-main">
                        <div class="record-title-with-icon">
                            <span class="type-icon" role="img" aria-label="@typeIcon.Label">@typeIcon.Symbol</span>
                            <div>
                                <p class="record-type">@(resource.ResourceTypeName ?? "Ressurs")</p>
                                <h2>@resource.Title</h2>
                            </div>
                        </div>
                        <p class="overview-description">@resource.Description</p>
                    </div>

                    <div class="overview-meta">
                        <div>
                            <span>Status</span>
                            <strong>@resource.Status</strong>
                        </div>
                        <div>
                            <span>Tilgjengelig fra</span>
                            <strong>@(resource.AvailableFrom?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")</strong>
                        </div>
                        <div>
                            <span>Mengde</span>
                            <strong>@resource.Quantity @resource.Unit</strong>
                        </div>
                    </div>

                    <div class="overview-record-footer">
                        <span class="status available">@resource.Status</span>
                        <div class="record-actions">
                            <a asp-action="Details" asp-route-id="@resource.ResourceId" class="portal-button secondary">Se detaljer</a>
                            @if (canManage)
                            {
                                <a asp-action="Edit" asp-route-id="@resource.ResourceId" class="portal-button secondary">Rediger</a>
                                <a asp-action="Delete" asp-route-id="@resource.ResourceId" class="portal-button danger">Slett</a>
                            }
                        </div>
                    </div>
                </article>
            }
        }
    </section>
</section>

@section Scripts {
    <script src="~/js/overview-map.js" asp-append-version="true"></script>
    <script>
        PortalOverviewMap.create("resourceMap", @Html.Raw(JsonSerializer.Serialize(mapEntries)));
    </script>
}
