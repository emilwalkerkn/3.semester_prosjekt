@using System.Text.Json
@model IEnumerable<SemesterProsjekt.Models.Resource>

@{
    ViewData["Title"] = "Ressursoversikt";
}

<h1>Ressursoversikt</h1>

<a asp-controller="Resource"
   asp-action="Print"
   class="btn btn-outline-secondary mb-3">
    Skriv ut ressursliste
</a>

<h2>Registrerte ressurser på kartet</h2>

<div id="resourceMap" style="height: 500px; margin-bottom: 30px;"></div>

@if (!Model.Any())
{
    <p>Ingen ressurser ble funnet.</p>
}
else
{
    @foreach (var resource in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@resource.Title</h5>

                <p class="card-text">
                    @resource.Description
                </p>

                <p>
                    <strong>Ressurstype-ID:</strong>
                    @resource.ResourceTypeId
                </p>

                <p>
                    <strong>Mengde:</strong>
                    @resource.Quantity @resource.Unit
                </p>

                <p>
                    <strong>Status:</strong>
                    @resource.Status
                </p>

                <p>
                    <strong>Tilgjengelig til:</strong>
                    @(resource.AvailableTo?.ToString("dd.MM.yyyy HH:mm")
                      ?? "Ikke oppgitt")
                </p>

                <a asp-controller="Resource"
                   asp-action="Details"
                   asp-route-id="@resource.ResourceId"
                   class="btn btn-outline-secondary">
                    Se detaljer
                </a>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        // Oppretter kartet med Kristiansand som startposisjon.
        var resourceMap = L.map("resourceMap")
            .setView([58.1467, 7.9956], 12);

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution: "&copy; OpenStreetMap contributors"
            }
        ).addTo(resourceMap);

        @foreach (var resource in Model)
        {
            if (!string.IsNullOrWhiteSpace(resource.GeometryData))
            {
                <text>
                try {
                    var geometryData =
                        @Html.Raw(JsonSerializer.Serialize(resource.GeometryData));

                    var geoJson = JSON.parse(geometryData);

                    var popupText =
                        @Html.Raw(JsonSerializer.Serialize(resource.Title));

                    L.geoJSON(geoJson)
                        .addTo(resourceMap)
                        .bindPopup(popupText);
                }
                catch {
                    console.error(
                        "Kunne ikke vise geometri for ressurs @resource.ResourceId"
                    );
                }
                </text>
            }
        }
    </script>
}