@model SemesterProsjekt.Models.ResourceViewModel
@{
    var editing = Model.ResourceId > 0;
    var heading = editing ? "Rediger ressurs" : "Registrer ressurs";
}

<section class="registration-page need-registration">
    <header class="registration-heading">
        <p class="home-eyebrow">Ressurseier</p>
        <h1>@heading</h1>
        <p>Beskriv hva dere kan bidra med, når ressursen er tilgjengelig og hvor den finnes.</p>
    </header>
    <form asp-controller="Resource" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.ResourceId : (int?)null)" method="post" class="need-registration-layout">
        <input asp-for="ResourceId" type="hidden" />
        <div class="portal-card registration-card">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="ResourceTypeId">Ressurstype</label>
                    <select asp-for="ResourceTypeId" asp-items="Model.ResourceTypes"><option value="">Velg ressurstype</option></select>
                    <span asp-validation-for="ResourceTypeId"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Status">Status</label>
                    <select asp-for="Status"><option value="Available">Tilgjengelig</option><option value="Unavailable">Ikke tilgjengelig</option></select>
                    <span asp-validation-for="Status"></span>
                </div>
                <div class="form-field full"><label asp-for="Title">Tittel</label><input asp-for="Title" placeholder="For eksempel: Førstehjelpsutstyr" /><span asp-validation-for="Title"></span></div>
                <div class="form-field full"><label asp-for="Description">Beskrivelse</label><textarea asp-for="Description" rows="5" placeholder="Beskriv ressursen og annen viktig informasjon."></textarea><span asp-validation-for="Description"></span></div>
                <div class="form-field"><label asp-for="Quantity">Mengde</label><input asp-for="Quantity" type="number" min="0" step="0.01" placeholder="10" /><span asp-validation-for="Quantity"></span></div>
                <div class="form-field"><label asp-for="Unit">Enhet</label><input asp-for="Unit" placeholder="liter eller stk" /><span asp-validation-for="Unit"></span></div>
                <div class="form-field full">
                    <label asp-for="AvailableFrom">Når er ressursen tilgjengelig?</label>
                    <input asp-for="AvailableFrom" type="datetime-local" data-use-local-now="@(!editing && Context.Request.Method == "GET" ? "true" : "false")" />
                    <small>@(editing ? "Lagret tidspunkt vises. Endre dato og klokkeslett hvis tilgjengeligheten har endret seg." : "Foreslått tidspunkt er nå. Endre dato og klokkeslett dersom ressursen er tilgjengelig senere.")</small>
                    <span asp-validation-for="AvailableFrom"></span>
                    @if (editing && Model.AvailableTo.HasValue)
                    {
                        <small>Tidligere registrert sluttdato @Model.AvailableTo.Value.ToString("dd.MM.yyyy HH:mm") beholdes.</small>
                    }
                </div>
                <div class="form-field full"><label asp-for="ContactPoint">Kontaktinformasjon</label><input asp-for="ContactPoint" placeholder="Navn, telefonnummer eller e-postadresse" /><span asp-validation-for="ContactPoint"></span></div>
            </div>
            <div class="registration-actions"><a asp-action="Overview" class="portal-button secondary">Avbryt</a><button type="submit" class="portal-button">@(editing ? "Lagre endringer" : "Registrer ressurs")</button></div>
        </div>
        <aside class="portal-card need-map-panel" id="need-map-panel">
            <div class="registration-map-heading"><div><h2>Plassering på kartet</h2><p>Velg markør for et punkt eller tegn en linje. Plassering er påkrevd.</p></div></div>
            <button type="button" class="portal-button secondary need-fullscreen" aria-controls="need-map-panel">Vis kart i fullskjerm</button>
            <div id="ResourceMap" class="registration-map" data-registration-map data-geometry-type-id="GeometryType" data-geometry-data-id="GeometryData" data-map-status-id="ResourceMapStatus"></div>
            <input asp-for="GeometryType" type="hidden" id="GeometryType" /><input asp-for="GeometryData" type="hidden" id="GeometryData" />
            <p id="ResourceMapStatus" class="registration-map-status" aria-live="polite">Ingen plassering valgt ennå.</p>
            <span asp-validation-for="GeometryType"></span><span asp-validation-for="GeometryData"></span>
        </aside>
    </form>
</section>
