@*
    Dette er siden for å slette en ressurs.

    Siden:
    - Viser hvilken ressurs som skal slettes
    - Ber brukeren bekrefte slettingen
    - Lar brukeren avbryte
*@

@model SemesterProsjekt.Models.Resource

@{
    // Angir tittelen til siden.
    ViewData["Title"] = "Slett ressurs";
}

<h1>Slett ressurs</h1>

@* Viser tittelen på ressursen som skal slettes. *@
<p>
    Er du sikker på at du vil slette
    <strong>@Model.Title</strong>?
</p>

@*
    Skjemaet sender en POST-forespørsel til Delete-handlingen.
    ResourceId forteller controlleren hvilken ressurs som skal slettes.
*@
<form asp-action="Delete"
      asp-route-id="@Model.ResourceId"
      method="post">

    @* Bekrefter at ressursen skal slettes. *@
    <button type="submit"
            class="btn btn-danger">
        Slett
    </button>

    @*
        Avbryter slettingen og sender brukeren
        tilbake til detaljsiden for ressursen.
    *@
    <a asp-action="Details"
       asp-route-id="@Model.ResourceId"
       class="btn btn-secondary">
        Avbryt
    </a>
</form>