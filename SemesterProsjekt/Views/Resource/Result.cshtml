@model SemesterProsjekt.Models.Resource

@{
    ViewData["Title"] = "Ressurs registrert";
}

<div class="text-center">
    <h1>Ressurs registrert</h1>

    <div class="mt-4">
        <p>
            <strong>Tittel:</strong>
            @Model.Title
        </p>

        <p>
            <strong>Beskrivelse:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Ressurstype-ID:</strong>
            @Model.ResourceTypeId
        </p>

        <p>
            <strong>Lokasjon-ID:</strong>
            @Model.LocationId
        </p>

        <p>
            <strong>Mengde:</strong>
            @Model.Quantity @Model.Unit
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>
    </div>

    <a asp-controller="Resource"
       asp-action="Details"
       asp-route-id="@Model.ResourceId"
       class="btn btn-outline-secondary mt-3">
        Se detaljer
    </a>

    <a asp-controller="Resource"
       asp-action="Create"
       class="btn btn-primary mt-3">
        Registrer en ny ressurs
    </a>
</div>