@*
    Dette er bekreftelsessiden etter at en ressurs er registrert.

    Siden viser:
    - En bekreftelse på at ressursen er registrert
    - De viktigste opplysningene om ressursen
    - En lenke til detaljsiden
    - En lenke for å registrere en ny ressurs
*@

@model SemesterProsjekt.Models.Resource

@{
    // Angir tittelen til siden.
    ViewData["Title"] = "Ressurs registrert";
}

@* Viser innholdet midtstilt på siden. *@
<div class="text-center">
    <h1>Ressurs registrert</h1>

    @* Viser opplysningene som ble lagret. *@
    <div class="mt-4">

        <p>
            <strong>Tittel:</strong>
            @Model.Title
        </p>

        <p>
            <strong>Beskrivelse:</strong>
            @Model.Description
        </p>

        <p>
            <strong>Ressurstype-ID:</strong>
            @Model.ResourceTypeId
        </p>

        <p>
            <strong>Mengde:</strong>
            @Model.Quantity @Model.Unit
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>
    </div>

    @*
        Sender brukeren til detaljsiden
        for ressursen som nettopp ble registrert.
    *@
    <a asp-controller="Resource"
       asp-action="Details"
       asp-route-id="@Model.ResourceId"
       class="btn btn-outline-secondary mt-3">
        Se detaljer
    </a>

    @*
        Sender brukeren til skjemaet
        for å registrere en ny ressurs.
    *@
    <a asp-controller="Resource"
       asp-action="Create"
       class="btn btn-primary mt-3">
        Registrer en ny ressurs
    </a>
</div>