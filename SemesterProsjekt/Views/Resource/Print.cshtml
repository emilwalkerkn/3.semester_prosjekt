@model IEnumerable<SemesterProsjekt.Models.Resource>

@{
Layout = null;
}

<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ressursliste – utskrift</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #999;
            padding: 8px;
            text-align: left;
            overflow-wrap: anywhere;
        }

        th {
            background-color: #eee;
        }

        .actions {
            margin-bottom: 20px;
        }

        @@media print {
            .actions {
                display: none;
            }

            body {
                margin: 0;
            }

            tr {
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
<div class="actions">
    <button type="button" onclick="window.print()">
        Skriv ut
    </button>

    <a asp-controller="Resource"
       asp-action="Overview">
        Tilbake til oversikten
    </a>
</div>

<h1>Ressursliste</h1>

@if (!Model.Any())
{
<p>Ingen ressurser funnet.</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Tittel</th>
            <th>Ressurstype-ID</th>
            <th>Mengde</th>
            <th>Kontaktpunkt</th>
            <th>Status</th>
            <th>Tilgjengelig fra</th>
            <th>Tilgjengelig til</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var resource in Model)
        {
            <tr>
                <td>@resource.Title</td>
                <td>@resource.ResourceTypeId</td>
                <td>@resource.Quantity @resource.Unit</td>
                <td>@(resource.ContactPoint ?? "Ikke oppgitt")</td>
                <td>@resource.Status</td>
                <td>
                    @(resource.AvailableFrom?.ToString("dd.MM.yyyy HH:mm")
                    ?? "Ikke oppgitt")
                </td>
                <td>
                    @(resource.AvailableTo?.ToString("dd.MM.yyyy HH:mm")
                    ?? "Ikke oppgitt")
                </td>
            </tr>
        }
        </tbody>
    </table>
}
</body>
</html>