@*
    Hovedlayouten til Kriseportal.

    Inneholder CSS, JavaScript, navigasjon og området
    hvor innholdet fra det aktive viewet vises.
*@

@{
    // Rollen vises øverst til høyre på siden.
    var accountRole = User.Identity?.IsAuthenticated != true
        ? "Ikke innlogget"
        : User.IsInRole(AppRoles.Admin)
            ? "Administrator"
            : User.IsInRole(AppRoles.OrganizationAdmin)
                ? "Organisasjonsadministrator"
                : User.IsInRole(AppRoles.NeedsActor)
                    ? AppRoles.PublicActorDisplayName
                    : User.IsInRole(AppRoles.ResourceOwner)
                        ? "Ressurseier"
                        : "Bruker";
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SemesterProsjekt</title>

    <script>
        // Leser temaet før siden vises for å unngå hvitt blink i nattmodus.
        if (localStorage.getItem("kriseportal-theme") === "dark") {
            document.documentElement.classList.add("dark-mode");
        }
    </script>

    @* Bootstrap og prosjektets egne stiler. *@
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @* Kartbiblioteket Leaflet og tegneverktøyene. *@
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css" />

    @* Samlet CSS fra Razor-filenes tilhørende .cshtml.css-filer. *@
    <link rel="stylesheet"
          href="~/SemesterProsjekt.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="portal-layout">

            @* Navigasjon for innloggede brukere. *@
            <aside class="portal-sidebar">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="portal-brand"
                   aria-label="Kriseportal – gå til hjemmesiden">

                    @* Samme pin som på forsiden gjør portalens merke gjenkjennelig. *@
                    <partial name="_PortalPin" />

                    <span>Kriseportal</span>
                </a>

                <p class="portal-sidebar-label">Arbeidsområde</p>

                <nav aria-label="Hovedmeny">

                    @* Hjemmesiden. *@
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        Hjem
                    </a>

                    @* Behovsoversikten vises for brukere med innsyn i alle registreringer. *@
                    @if (ResourceVisibility.CanBrowseAll(User))
                    {
                        <a asp-controller="Need"
                           asp-action="Overview"
                           class="@((ViewContext.RouteData.Values["controller"]?.ToString() == "Need" &&
                                     ViewContext.RouteData.Values["action"]?.ToString() != "Create")
                                        ? "active"
                                        : "")">
                            Behov
                        </a>
                    }

                    @* Ressursoversikten tilpasses brukerens tilgang. *@
                    <a asp-controller="Resource"
                       asp-action="Overview"
                       class="@((ViewContext.RouteData.Values["controller"]?.ToString() == "Resource" &&
                                 ViewContext.RouteData.Values["action"]?.ToString() != "Create")
                                    ? "active"
                                    : "")">
                        @ResourceVisibility.OverviewTitle(User)
                    </a>

                    @* Administratorer, ressurseiere og behovsaktører får se matchoversikten. *@
                    @if (User.IsInRole(AppRoles.Admin) ||
                         User.IsInRole(AppRoles.ResourceOwner) ||
                         User.IsInRole(AppRoles.NeedsActor))
                    {
                        <a asp-controller="Match"
                           asp-action="Overview"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Match" ? "active" : "")">
                            @(ResourceVisibility.CanBrowseAll(User)
                                ? "Mine avtaler"
                                : "Forespørsler til meg")
                        </a>
                    }

                    @* Behovsaktører og administratorer kan registrere behov. *@
                    @if (User.IsInRole(AppRoles.NeedsActor) ||
                         User.IsInRole(AppRoles.Admin))
                    {
                        <a asp-controller="Need"
                           asp-action="Create"
                           class="@((ViewContext.RouteData.Values["controller"]?.ToString() == "Need" &&
                                     ViewContext.RouteData.Values["action"]?.ToString() == "Create")
                                        ? "active"
                                        : "")">
                            Registrer behov
                        </a>
                    }

                    @* Ressurseiere og administratorer kan registrere ressurser. *@
                    @if (User.IsInRole(AppRoles.ResourceOwner) ||
                         User.IsInRole(AppRoles.Admin))
                    {
                        <a asp-controller="Resource"
                           asp-action="Create"
                           class="@((ViewContext.RouteData.Values["controller"]?.ToString() == "Resource" &&
                                     ViewContext.RouteData.Values["action"]?.ToString() == "Create")
                                        ? "active"
                                        : "")">
                            Registrer ressurs
                        </a>
                    }

                    @* Organisasjonsgodkjenning for systemadministratorer. *@
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <a asp-controller="OrganizationApproval"
                           asp-action="Index"
                           class="@((ViewContext.RouteData.Values["controller"]?.ToString() == "OrganizationApproval" &&
                                     ViewContext.RouteData.Values["action"]?.ToString() == "Index")
                                        ? "active"
                                        : "")">
                            Godkjenn organisasjoner
                        </a>

                        <a asp-controller="OrganizationApproval"
                           asp-action="Approved"
                           class="@((ViewContext.RouteData.Values["controller"]?.ToString() == "OrganizationApproval" &&
                                     ViewContext.RouteData.Values["action"]?.ToString() == "Approved")
                                        ? "active"
                                        : "")">
                            Godkjente organisasjoner
                        </a>
                    }

                    @* Ansatte og invitasjoner for organisasjonsadministratorer. *@
                    @if (User.IsInRole(AppRoles.OrganizationAdmin))
                    {
                        <a asp-controller="OrganizationAdmin"
                           asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "OrganizationAdmin" ? "active" : "")">
                            Administrer ansatte
                        </a>

                        <a asp-controller="OrganizationInvitation"
                           asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "OrganizationInvitation" ? "active" : "")">
                            Inviter ansatte
                        </a>
                    }

                    @* Innstillinger. *@
                    <a asp-controller="Settings"
                       asp-action="Index"
                       class="settings-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")"
                       aria-label="Innstillinger"
                       title="Innstillinger">
                        <span aria-hidden="true">⚙</span>
                    </a>
                </nav>
            </aside>

            <div class="portal-main">

                @* Toppmenyen viser portalens område og brukerens rolle. *@
                <header class="portal-topbar">
                    <p class="portal-context">
                        Ressurs- og behovsoppfølging
                    </p>

                    <div class="portal-account">
                        @await Component.InvokeAsync("NotificationBell")

                        <span>@accountRole</span>
                    </div>
                </header>

                @* Innholdet fra det aktive viewet. *@
                <main role="main" class="portal-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @* Offentlige sider vises uten portalens navigasjon. *@
        <main class="public-page" role="main">
            @RenderBody()
        </main>
    }

    @* jQuery brukes blant annet til skjemavalidering. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Prosjektets JavaScript, inkludert bryteren for nattmodus. *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Kartbiblioteket og tegneverktøyene. *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin="">
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>