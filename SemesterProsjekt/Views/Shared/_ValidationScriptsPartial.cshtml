@*
    Dette partial viewet henter JavaScript for validering.

    Skriptene gjør at brukeren kan få feilmeldinger
    i nettleseren før skjemaet sendes til serveren.
*@

@* Inneholder grunnleggende funksjoner for validering. *@
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js">
</script>

@*
    Kobler valideringsreglene fra ASP.NET-modellen
    til valideringen i nettleseren.
*@
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js">
</script>