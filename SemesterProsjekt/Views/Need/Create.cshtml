@model SemesterProsjekt.Models.NeedViewModel

@{
    ViewData["Title"] = "Registrer behov";
}

<section class="registration-page">
    <header class="registration-heading">
        <p class="home-eyebrow">Behovsaktør</p>
        <h1>Registrer behov</h1>
        <p>Beskriv behovet, når det trengs og hvor hjelpen skal leveres.</p>
    </header>

    <form asp-controller="Need" asp-action="Create" method="post" class="portal-card registration-card">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <div class="form-grid">
            <div class="form-field">
                <label asp-for="NeedTypeId"></label>
                <select asp-for="NeedTypeId" asp-items="Model.NeedTypes">
                    <option value="">Velg type behov</option>
                </select>
                <span asp-validation-for="NeedTypeId" class="field-validation-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Priority">Prioritet</label>
                <select asp-for="Priority">
                    <option value="Low">Lav</option>
                    <option value="Normal">Normal</option>
                    <option value="High">Høy</option>
                    <option value="Critical">Kritisk</option>
                </select>
                <span asp-validation-for="Priority" class="field-validation-error"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Title">Tittel</label>
                <input asp-for="Title" autocomplete="off" placeholder="For eksempel: Drikkevann til evakueringssenter" />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Description">Beskrivelse</label>
                <textarea asp-for="Description" rows="5" placeholder="Forklar hva som trengs, hvem behovet gjelder og annen viktig informasjon."></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Quantity">Mengde</label>
                <input asp-for="Quantity" type="number" min="0" step="0.01" placeholder="For eksempel 50" />
                <span asp-validation-for="Quantity" class="field-validation-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Unit">Enhet</label>
                <input asp-for="Unit" placeholder="For eksempel stk, kg eller liter" />
                <span asp-validation-for="Unit" class="field-validation-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="NeededFrom">Behov fra</label>
                <input asp-for="NeededFrom" type="datetime-local" />
                <span asp-validation-for="NeededFrom" class="field-validation-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Deadline">Frist</label>
                <input asp-for="Deadline" type="datetime-local" />
                <span asp-validation-for="Deadline" class="field-validation-error"></span>
            </div>

            <div class="form-field full">
                <label asp-for="ContactPoint">Kontaktpunkt</label>
                <input asp-for="ContactPoint" placeholder="Navn, telefonnummer eller e-postadresse" />
                <span asp-validation-for="ContactPoint" class="field-validation-error"></span>
            </div>

            <div class="form-field full registration-map-field">
                <div class="registration-map-heading">
                    <div>
                        <label for="NeedMap">Plassering på kartet</label>
                        <p>Velg markør-knappen i kartet og plasser ett punkt på riktig sted.</p>
                    </div>
                    <span class="required-label">Påkrevd</span>
                </div>

                <div id="NeedMap" class="registration-map" data-registration-map data-geometry-type-id="GeometryType" data-geometry-data-id="GeometryData" data-map-status-id="NeedMapStatus"></div>
                <input asp-for="GeometryType" type="hidden" id="GeometryType" />
                <input asp-for="GeometryData" type="hidden" id="GeometryData" />
                <p id="NeedMapStatus" class="registration-map-status" aria-live="polite">Ingen plassering valgt ennå.</p>
                <span asp-validation-for="GeometryType" class="field-validation-error"></span>
                <span asp-validation-for="GeometryData" class="field-validation-error"></span>
            </div>
        </div>

        <input asp-for="Status" type="hidden" />

        <div class="registration-actions">
            <a asp-action="Overview" class="portal-button secondary">Avbryt</a>
            <button type="submit" class="portal-button">Registrer behov</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registration-map.js" asp-append-version="true"></script>
}
