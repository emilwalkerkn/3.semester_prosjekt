@model SemesterProsjekt.Models.Need
@{
    ViewData["Title"] = "Slett behov";
}
<h1>Slett behov</h1>
<p>Er du sikker på at du vil slette <strong>@Model.Title</strong>?</p>
<form asp-action="Delete" asp-route-id="@Model.NeedId" method="post">
    <button type="submit" class="btn btn-danger">Slett</button>
    <a asp-action="Details" asp-route-id="@Model.NeedId" class="btn btn-secondary">Avbryt</a>
</form>
