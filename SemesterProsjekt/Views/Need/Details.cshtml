@model SemesterProsjekt.Models.Need

@{
    ViewData["Title"] = "Behovsdetaljer";
}

<h1>Behovsdetaljer</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>

        <p class="card-text">
            <strong>Beskrivelse:</strong><br />
            @Model.Description
        </p>

        <p class="card-text">
            <strong>Behovstype-ID:</strong>
            @Model.NeedTypeId
        </p>
        
        <p class="card-text">
            <strong>Mengde:</strong>
            @Model.Quantity @Model.Unit
        </p>

        <p class="card-text">
            <strong>Status:</strong>
            @Model.Status
        </p>

        <p class="card-text">
            <strong>Prioritet:</strong>
            @Model.Priority
        </p>

        <p class="card-text">
            <strong>Kontaktpunkt:</strong>
            @(Model.ContactPoint ?? "Ikke oppgitt")
        </p>

        <p class="card-text">
            <strong>Behov fra:</strong>
            @(Model.NeededFrom?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")
        </p>

        <p class="card-text">
            <strong>Frist:</strong>
            @(Model.Deadline?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.GeometryType))
        {
            <p class="card-text">
                <strong>Geometri:</strong>
                @Model.GeometryType
            </p>
        }
    </div>
</div>

<a asp-controller="Need"
   asp-action="Overview"
   class="btn btn-secondary mt-3">
    Tilbake til behovsoversikten
</a>
@if (User.IsInRole("Admin") || User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId)
{
    <a asp-action="Edit" asp-route-id="@Model.NeedId" class="btn btn-primary mt-3">Rediger</a>
    <a asp-action="Delete" asp-route-id="@Model.NeedId" class="btn btn-danger mt-3">Slett</a>
}
