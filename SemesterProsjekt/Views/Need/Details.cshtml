@model SemesterProsjekt.Models.Need

@{
    ViewData["Title"] = "Behovsdetaljer";
    var canManage = User.IsInRole("Admin") || User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId;
    var statusText = Model.Status switch
    {
        "New" => "Ny",
        "In progress" => "Under behandling",
        "Resolved" => "Løst",
        _ => Model.Status
    };
    var statusClass = Model.Status == "Resolved" ? "resolved" : Model.Status is "New" or "In progress" ? "warning" : "";
}

<section class="details-page">
    <a asp-action="Overview" class="back-link">← Tilbake til behov</a>

    <article class="portal-card details-card">
        <header class="details-heading">
            <div>
                <p class="record-type">@(Model.NeedTypeName ?? "Behov")</p>
                <h1>@Model.Title</h1>
            </div>
            <span class="status @statusClass">@statusText</span>
        </header>

        <p class="details-description">@Model.Description</p>

        <dl class="details-grid">
            <div><dt>Type</dt><dd>@(Model.NeedTypeName ?? "Ikke oppgitt")</dd></div>
            <div><dt>Prioritet</dt><dd>@Model.Priority</dd></div>
            <div><dt>Mengde</dt><dd>@Model.Quantity @Model.Unit</dd></div>
            <div><dt>Kontaktpunkt</dt><dd>@(Model.ContactPoint ?? "Ikke oppgitt")</dd></div>
            <div><dt>Behov fra</dt><dd>@(Model.NeededFrom?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")</dd></div>
            <div><dt>Frist</dt><dd>@(Model.Deadline?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")</dd></div>
        </dl>

        @if (canManage)
        {
            <div class="record-actions details-actions">
                <a asp-action="Edit" asp-route-id="@Model.NeedId" class="portal-button">Rediger behov</a>
                <a asp-action="Delete" asp-route-id="@Model.NeedId" class="portal-button danger">Slett behov</a>
            </div>
        }
    </article>
</section>
