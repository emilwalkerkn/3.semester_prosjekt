@model SemesterProsjekt.Models.Need

@{
    ViewData["Title"] = "Behovsdetaljer";
}

<h1>Behovsdetaljer</h1>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Type</h5>

        <p class="card-text">
            <strong>Beskrivelse:</strong><br />
            @Model.Description
        </p>

        <p class="card-text">
            <strong>Sted:</strong><br />
            @Model.Location
        </p>

        <p class="card-text">
            <strong>Koordinater:</strong><br />
            @Model.Latitude, @Model.Longitude
        </p>
        
        <p class="card-text">
            <strong>Prioritet:</strong> @Model.Priority
        </p>

        <p class="card-text">
            <strong>Kontaktpunkt:</strong> @Model.ContactPoint
        </p>

        <p class="card-text">
            <strong>Behov fra:</strong> @Model.NeededFrom
        </p>

        <p class="card-text">
            <strong>Frist:</strong> @Model.Deadline
        </p>
    </div>
</div>

<a asp-controller="Need"
   asp-action="Overview"
   class="btn btn-secondary mt-3">
    Tilbake til behovsoversikten
</a>