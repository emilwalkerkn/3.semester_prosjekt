@using System.Text.Json
@model IEnumerable<SemesterProsjekt.Models.Need>

@{
    ViewData["Title"] = "Behovsoversikt";
    var currentUserId = ViewData["CurrentUserId"] is int currentUserIdValue ? currentUserIdValue : 0;
    var canManageAll = ViewData["CanManageAll"] is true;
}

<h1>Behov</h1>
<p class="page-intro">Søk i registrerte behov og finn tilgjengelige ressurser i nærheten.</p>

<div class="filter-bar">
    <input id="needSearch" type="search" placeholder="Søk i behov" aria-label="Søk i behov" />
    <select id="needStatus" aria-label="Filtrer på status"><option value="">Alle statuser</option><option value="New">Ny</option><option value="In progress">Under behandling</option><option value="Resolved">Løst</option></select>
</div>

@if (!Model.Any())
{
    <div class="portal-card empty-state">Ingen behov er registrert ennå.</div>
}
else
{
    @foreach (var need in Model)
    {
        var typeIcon = PortalTypeIcons.ForNeed(need.NeedTypeId);

        <article class="portal-card record-card" data-title="@need.Title" data-status="@need.Status">
                <span class="record-status status">@need.Status</span>
                <div class="record-title-with-icon">
                    <span class="type-icon" role="img" aria-label="@typeIcon.Label">@typeIcon.Symbol</span>
                    <div>
                        <p class="record-type">@typeIcon.Label</p>
                        <h2>@need.Title</h2>
                    </div>
                </div>
                <p>@need.Description</p>
                <p class="mt-2">@need.Quantity @need.Unit · Frist: @(need.Deadline?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")</p>

                <div class="record-actions"><a asp-controller="Need" asp-action="Details" asp-route-id="@need.NeedId" class="portal-button secondary">
                    Se detaljer
                </a>
                @if (canManageAll || (need.UserId == currentUserId && User.IsInRole("Behovsaktør")))
                {
                    <form asp-controller="Need"
                          asp-action="UpdateStatus"
                          method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@need.NeedId" />

                    <select name="status">
                        <option value="New"
                                selected="@(need.Status == "New")">
                            Ny
                        </option>

                        <option value="In progress"
                                selected="@(need.Status == "In progress")">
                            Under behandling
                        </option>

                        <option value="Resolved"
                                selected="@(need.Status == "Resolved")">
                            Løst
                        </option>
                    </select>

                    <button type="submit">
                        Oppdater status
                    </button>
                    </form>
                }
                </div>
        </article>
    }
}

@section Scripts {
    <script>
        const filterNeeds = () => {
            const query = document.getElementById("needSearch").value.toLowerCase();
            const status = document.getElementById("needStatus").value;
            document.querySelectorAll(".record-card").forEach(card => {
                card.hidden = !(card.dataset.title.toLowerCase().includes(query) && (!status || card.dataset.status === status));
            });
        };
        document.getElementById("needSearch").addEventListener("input", filterNeeds);
        document.getElementById("needStatus").addEventListener("change", filterNeeds);

        const mapHost = document.createElement("div"); mapHost.id = "needMap"; mapHost.className = "map-panel";
        document.querySelector(".filter-bar").after(mapHost);
        // Oppretter kartet med Kristiansand som startposisjon.
        var needMap = L.map("needMap")
            .setView([58.1467, 7.9956], 12);

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution: "&copy; OpenStreetMap contributors"
            }
        ).addTo(needMap);

        @foreach (var need in Model)
        {
            if (!string.IsNullOrWhiteSpace(need.GeometryData))
            {
                <text>
                try {
                    var geometryData =
                        @Html.Raw(JsonSerializer.Serialize(need.GeometryData));

                    var geoJson = JSON.parse(geometryData);

                    var popupText =
                        @Html.Raw(JsonSerializer.Serialize(need.Title));

                    L.geoJSON(geoJson)
                        .addTo(needMap)
                        .bindPopup(popupText);
                }
                catch {
                    console.error(
                        "Kunne ikke vise geometri for behov @need.NeedId"
                    );
                }
                </text>
            }
        }
    </script>
}
