@*
    Dette er siden for å redigere et behov.

    Her kan brukeren:
    - Endre typen behov
    - Endre tittel og beskrivelse
    - Endre mengde og kontaktinformasjon
    - Endre tidspunkt og frist
    - Endre prioritet og status
*@

@model SemesterProsjekt.Models.NeedViewModel

@{
    // Angir tittelen til siden.
    ViewData["Title"] = "Rediger behov";
}

<h1>Rediger behov</h1>

@*
    Skjemaet sender de oppdaterte opplysningene
    til Edit-handlingen i NeedController.
*@
<form asp-action="Edit"
      asp-route-id="@Model.NeedId"
      method="post">

    @*
        Skjulte felt bevarer ID-en og kartinformasjonen.
        Brukeren ser ikke disse feltene.
    *@
    <input asp-for="NeedId"
           type="hidden" />

    <input asp-for="GeometryType"
           type="hidden" />

    <input asp-for="GeometryData"
           type="hidden" />

    @* Viser feilmeldinger som gjelder hele modellen. *@
    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    @* Nedtrekksliste for type behov. *@
    <div class="mb-3">
        <label asp-for="NeedTypeId"
               class="form-label">
        </label>

        <select asp-for="NeedTypeId"
                asp-items="Model.NeedTypes"
                class="form-select">
        </select>

        <span asp-validation-for="NeedTypeId"
              class="text-danger">
        </span>
    </div>

    @* Felt for tittelen til behovet. *@
    <div class="mb-3">
        <label asp-for="Title"
               class="form-label">
            Tittel
        </label>

        <input asp-for="Title"
               class="form-control" />

        <span asp-validation-for="Title"
              class="text-danger">
        </span>
    </div>

    @* Felt for en mer detaljert beskrivelse. *@
    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
            Beskrivelse
        </label>

        <textarea asp-for="Description"
                  class="form-control">
        </textarea>
    </div>

    @* Felt for mengden som trengs. *@
    <div class="mb-3">
        <label asp-for="Quantity"
               class="form-label">
            Mengde
        </label>

        <input asp-for="Quantity"
               class="form-control" />
    </div>

    @* Felt for enheten til mengden. *@
    <div class="mb-3">
        <label asp-for="Unit"
               class="form-label">
            Enhet
        </label>

        <input asp-for="Unit"
               class="form-control" />
    </div>

    @* Felt for kontaktinformasjon. *@
    <div class="mb-3">
        <label asp-for="ContactPoint"
               class="form-label">
            Kontaktpunkt
        </label>

        <input asp-for="ContactPoint"
               class="form-control" />
    </div>

    @* Velger datoen og tidspunktet behovet starter. *@
    <div class="mb-3">
        <label asp-for="NeededFrom"
               class="form-label">
            Behov fra
        </label>

        <input asp-for="NeededFrom"
               type="datetime-local"
               class="form-control" />
    </div>

    @* Velger fristen for behovet. *@
    <div class="mb-3">
        <label asp-for="Deadline"
               class="form-label">
            Frist
        </label>

        <input asp-for="Deadline"
               type="datetime-local"
               class="form-control" />
    </div>

    @* Nedtrekksliste for prioriteten til behovet. *@
    <div class="mb-3">
        <label asp-for="Priority"
               class="form-label">
            Prioritet
        </label>

        <select asp-for="Priority"
                class="form-select">
            <option value="Low">Lav</option>
            <option value="Normal">Normal</option>
            <option value="High">Høy</option>
            <option value="Critical">Kritisk</option>
        </select>
    </div>

    @* Nedtrekksliste for statusen til behovet. *@
    <div class="mb-3">
        <label asp-for="Status"
               class="form-label">
            Status
        </label>

        <select asp-for="Status"
                class="form-select">
            <option value="New">Ny</option>
            <option value="In progress">Under behandling</option>
            <option value="Resolved">Løst</option>
        </select>
    </div>

    @* Lagrer endringene. *@
    <button type="submit"
            class="btn btn-primary">
        Lagre
    </button>

    @*
        Avbryter redigeringen og går tilbake
        til detaljsiden uten å lagre.
    *@
    <a asp-action="Details"
       asp-route-id="@Model.NeedId"
       class="btn btn-secondary">
        Avbryt
    </a>
</form>