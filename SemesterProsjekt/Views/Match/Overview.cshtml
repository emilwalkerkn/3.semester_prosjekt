@model IEnumerable<SemesterProsjekt.Models.ViewModels.MatchListItemViewModel>
@{
    ViewData["Title"] = "Matcher";
    var matches = Model.ToList();
    var proposedCount = matches.Count(match => match.Status == SemesterProsjekt.Models.MatchStatuses.Proposed);
    var approvedCount = matches.Count(match => match.Status == SemesterProsjekt.Models.MatchStatuses.Approved);

    string StatusText(string status) => status switch
    {
        SemesterProsjekt.Models.MatchStatuses.Proposed => "Forslag",
        SemesterProsjekt.Models.MatchStatuses.Approved => "Godkjent",
        SemesterProsjekt.Models.MatchStatuses.Completed => "Fullført",
        SemesterProsjekt.Models.MatchStatuses.Declined => "Avslått",
        _ => status
    };

    string StatusClass(string status) => status switch
    {
        SemesterProsjekt.Models.MatchStatuses.Proposed => "warning",
        SemesterProsjekt.Models.MatchStatuses.Approved => "available",
        SemesterProsjekt.Models.MatchStatuses.Completed => "resolved",
        SemesterProsjekt.Models.MatchStatuses.Declined => "critical",
        _ => ""
    };
}

<section class="overview-page match-page">
    <header class="overview-heading">
        <div>
            <p class="eyebrow">Koordinering</p>
            <h1>Matcher</h1>
            <p class="page-intro">Koble behov med riktige ressurser, og følg hvert forslag frem til det er fullført.</p>
        </div>

        <div class="overview-heading-actions">
            <a asp-action="History" class="portal-button secondary">Matchhistorikk</a>
            <a asp-action="Create" class="portal-button">+ Opprett match</a>
        </div>
    </header>

    <section class="match-summary-grid" aria-label="Matchstatus">
        <article class="portal-card match-summary-card">
            <span>Aktive matcher</span>
            <strong>@matches.Count</strong>
            <p>Forslag og godkjente matcher.</p>
        </article>
        <article class="portal-card match-summary-card">
            <span>Venter på godkjenning</span>
            <strong>@proposedCount</strong>
            <p>Forslag som må følges opp.</p>
        </article>
        <article class="portal-card match-summary-card">
            <span>Klare for fullføring</span>
            <strong>@approvedCount</strong>
            <p>Godkjente matcher som kan avsluttes.</p>
        </article>
    </section>

    <section class="overview-list match-list" aria-label="Aktive matcher">
        @if (matches.Count == 0)
        {
            <div class="portal-card empty-state">
                <h2>Ingen aktive matcher</h2>
                <p>Opprett en match når du har funnet en ressurs som kan dekke et behov.</p>
                <a asp-action="Create" class="portal-button">Opprett match</a>
            </div>
        }
        else
        {
            @foreach (var item in matches)
            {
                <article class="portal-card match-card">
                    <div class="match-card-heading">
                        <div>
                            <p class="eyebrow">Match #@item.MatchId</p>
                            <h2>Behov og ressurs</h2>
                        </div>
                        <span class="status @StatusClass(item.Status)">@StatusText(item.Status)</span>
                    </div>

                    <div class="match-pair">
                        <div class="match-party">
                            <span class="match-party-label">Behov</span>
                            <a asp-controller="Need" asp-action="Details" asp-route-id="@item.NeedId">@item.NeedTitle</a>
                        </div>
                        <span class="match-arrow" aria-label="koblet med">↔</span>
                        <div class="match-party">
                            <span class="match-party-label">Ressurs</span>
                            <a asp-controller="Resource" asp-action="Details" asp-route-id="@item.ResourceId">@item.ResourceTitle</a>
                        </div>
                    </div>

                    <div class="match-meta">
                        <div>
                            <span>Opprettet</span>
                            <strong>@item.MatchedAt.ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>
                        <div>
                            <span>Neste steg</span>
                            <strong>@(item.Status == SemesterProsjekt.Models.MatchStatuses.Proposed ? "Godkjenn forslaget" : "Marker som fullført")</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <p class="match-note"><strong>Notat:</strong> @item.Notes</p>
                    }

                    <div class="record-actions">
                        @if (item.Status == SemesterProsjekt.Models.MatchStatuses.Proposed)
                        {
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id" value="@item.MatchId" />
                                <input type="hidden" name="status" value="@SemesterProsjekt.Models.MatchStatuses.Approved" />
                                <button type="submit" class="portal-button">Godkjenn forslag</button>
                            </form>
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id" value="@item.MatchId" />
                                <input type="hidden" name="status" value="@SemesterProsjekt.Models.MatchStatuses.Declined" />
                                <button type="submit" class="portal-button danger">Avslå forslag</button>
                            </form>
                        }
                        else if (item.Status == SemesterProsjekt.Models.MatchStatuses.Approved)
                        {
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id" value="@item.MatchId" />
                                <input type="hidden" name="status" value="@SemesterProsjekt.Models.MatchStatuses.Completed" />
                                <button type="submit" class="portal-button">Marker som fullført</button>
                            </form>
                        }
                    </div>
                </article>
            }
        }
    </section>
</section>
