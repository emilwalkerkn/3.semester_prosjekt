@*
    Dette er oversikten over åpne matchforslag.

    Administratorer ser alle matcher.
    Behovsaktører og ressurseiere ser matcher som gjelder egne registreringer.

    Begge aktørtypene kan foreslå nye matcher.
    Motparten kan godkjenne eller avslå et forslag.
    Begge parter kan fullføre godkjente matcher fra historikken.
    Administratorer har tilgang til alle matcher, men er ikke nødvendige i flyten.

    Controlleren kontrollerer rettighetene.
    Repositoryet filtrerer hvilke matcher brukeren får se.
*@

@model IEnumerable<SemesterProsjekt.Models.ViewModels.MatchListItemViewModel>
@using SemesterProsjekt.Models

@{
    ViewData["Title"] = "Matcher";

    // Rollen avgjør hvilke tekster og handlinger som vises.
    var isAdmin = User.IsInRole(AppRoles.Admin);

    // Bare offentlig aktør og admin kan velge behov for et nytt forslag.
    var canPropose = isAdmin ||
                     User.IsInRole(AppRoles.NeedsActor);

    // Controlleren sender bare matcher brukeren har tilgang til.
    var matches = Model.ToList();

    // Godkjente og avslåtte forslag ligger i historikken.
    var proposedCount = matches.Count(match =>
        match.Status == MatchStatuses.Proposed);

    var responseCount = matches.Count(match => match.CanRespond);
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var sentCount = matches.Count(match => match.ProposedByUserId == currentUserId);

    // Gjør statusverdiene lettere å forstå i grensesnittet.
    string StatusText(string status) => status switch
    {
        MatchStatuses.Proposed => "Forslag",
        MatchStatuses.Approved => "Godkjent",
        MatchStatuses.Completed => "Fullført",
        MatchStatuses.Declined => "Avslått",
        _ => status
    };

    // Velger CSS-klassen som passer til statusen.
    string StatusClass(string status) => status switch
    {
        MatchStatuses.Proposed => "warning",
        MatchStatuses.Approved => "available",
        MatchStatuses.Completed => "resolved",
        MatchStatuses.Declined => "critical",
        _ => ""
    };

    // Rettighetene er beregnet i controlleren, ikke bare fra brukerens rolle.
    string NextStep(SemesterProsjekt.Models.ViewModels.MatchListItemViewModel match) => match.Status switch
    {
        MatchStatuses.Proposed => match.CanRespond
            ? "Godkjenn eller avslå forslaget"
            : string.IsNullOrWhiteSpace(match.ProposedByUserId)
                ? "Venter på administrator"
                : "Venter på svar fra motparten",

        MatchStatuses.Approved => match.CanComplete
            ? "Marker som fullført"
            : "Matchen er godkjent",

        _ => StatusText(match.Status)
    };
}

<section class="overview-page match-page">

    @* Overskriften og introduksjonen tilpasses brukerens rolle. *@
    <header class="overview-heading">
        <div>
            <p class="eyebrow">Koordinering</p>

            <h1>@(isAdmin ? "Matcher" : "Mine matcher")</h1>

            <p class="page-intro">
                @(isAdmin
                    ? "Foreslå koblinger mellom behov og ressurser, og følg matchene frem til de er fullført."
                    : "Foreslå matcher og følg koblinger som gjelder dine behov eller ressurser.")
            </p>
        </div>

        @* Historikken er tilgjengelig for alle de tre aktørrollene. *@
        <div class="overview-heading-actions">
            <a asp-action="History"
               class="portal-button secondary">
                Matchhistorikk
            </a>

            @* Begge aktørtypene og admin kan åpne forslagsskjemaet. *@
            @if (canPropose)
            {
                <a asp-action="Create"
                   class="portal-button">
                    + Foreslå match
                </a>
            }
        </div>
    </header>

    @* Oppsummerer matchene i brukerens filtrerte modell. *@
    <section class="match-summary-grid"
             aria-label="Matchstatus">

        <article class="portal-card match-summary-card">
            <span>Åpne forslag</span>
            <strong>@proposedCount</strong>
            <p>Matcher som venter på svar.</p>
        </article>

        <article class="portal-card match-summary-card">
            <span>Venter på ditt svar</span>
            <strong>@responseCount</strong>
            <p>Forslag du kan godkjenne eller avslå.</p>
        </article>

        <article class="portal-card match-summary-card">
            <span>Sendte forslag</span>
            <strong>@sentCount</strong>
            <p>Dine forslag som venter på svar.</p>
        </article>
    </section>

    @* Listen over aktive matcher. *@
    <section class="overview-list match-list"
             aria-label="Aktive matcher">

        @* Viser en melding og forslag til neste steg når listen er tom. *@
        @if (matches.Count == 0)
        {
            <div class="portal-card empty-state">
                <h2>Ingen åpne matchforslag</h2>

                @if (canPropose)
                {
                    <p>
                        Foreslå en kobling mellom et behov og en ressurs
                        som kan dekke behovet.
                    </p>

                    <a asp-action="Create"
                       class="portal-button">
                        Foreslå match
                    </a>
                }
                else
                {
                    <p>
                        Du har ingen aktive matcher knyttet til
                        dine behov eller ressurser ennå.
                    </p>
                }
            </div>
        }
        else
        {
            @* Viser ett kort for hver match brukeren har tilgang til. *@
            @foreach (var item in matches)
            {
                <article class="portal-card match-card">

                    @* Viser nummeret og statusen til matchen. *@
                    <div class="match-card-heading">
                        <div>
                            <p class="eyebrow">
                                Match #@item.MatchId
                            </p>

                            <h2>Behov og ressurs</h2>
                        </div>

                        @*
                            StatusClass bestemmer fargen.
                            StatusText viser den lesbare statusteksten.
                        *@
                        <span class="status @StatusClass(item.Status)">
                            @StatusText(item.Status)
                        </span>
                    </div>

                    @* Viser behovet og ressursen som er koblet sammen. *@
                    <div class="match-pair">
                        <div class="match-party">
                            <span class="match-party-label">
                                Behov
                            </span>

                            @* Lenke til detaljsiden for behovet. *@
                            <a asp-controller="Need"
                               asp-action="Details"
                               asp-route-id="@item.NeedId">
                                @item.NeedTitle
                            </a>
                        </div>

                        <span class="match-arrow"
                              aria-label="koblet med">
                            ↔
                        </span>

                        <div class="match-party">
                            <span class="match-party-label">
                                Ressurs
                            </span>

                            @* Lenke til detaljsiden for ressursen. *@
                            <a asp-controller="Resource"
                               asp-action="Details"
                               asp-route-id="@item.ResourceId">
                                @item.ResourceTitle
                            </a>
                        </div>
                    </div>

                    @* Viser tidspunkt og rolletilpasset informasjon om neste steg. *@
                    <div class="match-meta">
                        <div>
                            <span>Foreslått mengde</span>
                            <strong>@(item.AssignedQuantity.HasValue
                                ? $"{item.AssignedQuantity:0.##} {item.AssignedUnit}"
                                : "Resterende behov, maks ledig mengde")</strong>
                        </div>
                        <div>
                            <span>Opprettet</span>

                            <strong>
                                @item.MatchedAt.ToString("dd.MM.yyyy HH:mm")
                            </strong>
                        </div>

                        <div>
                            <span>Neste steg</span>

                            <strong>
                                @NextStep(item)
                            </strong>
                        </div>
                    </div>

                    @* Viser notatet bare dersom det inneholder tekst. *@
                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <p class="match-note">
                            <strong>Notat:</strong>
                            @item.Notes
                        </p>
                    }

                    @*
                        Motparten får svarknapper. Godkjente matcher følges opp i historikken.
                        Controlleren kontrollerer samme tilgang ved innsending.
                    *@
                    @if (item.CanRespond || item.CanComplete)
                    {
                        <div class="record-actions">

                            @* Et forslag kan godkjennes eller avslås. *@
                            @if (item.CanRespond)
                            {
                                @* Sender status Godkjent til UpdateStatus. *@
                                <form asp-action="UpdateStatus"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.MatchId" />

                                    <input type="hidden"
                                           name="status"
                                           value="@MatchStatuses.Approved" />

                                    <button type="submit"
                                            class="portal-button">
                                        Godkjenn forslag
                                    </button>
                                </form>

                                @* Sender status Avslått til UpdateStatus. *@
                                <form asp-action="UpdateStatus"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.MatchId" />

                                    <input type="hidden"
                                           name="status"
                                           value="@MatchStatuses.Declined" />

                                    <button type="submit"
                                            class="portal-button danger">
                                        Avslå forslag
                                    </button>
                                </form>
                            }
                            else if (item.CanComplete)
                            {
                                @* En godkjent match kan merkes som fullført. *@
                                <form asp-action="UpdateStatus"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.MatchId" />

                                    <input type="hidden"
                                           name="status"
                                           value="@MatchStatuses.Completed" />

                                    <button type="submit"
                                            class="portal-button">
                                        Marker som fullført
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </article>
            }
        }
    </section>
</section>
