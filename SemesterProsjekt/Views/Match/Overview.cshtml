@model IEnumerable<SemesterProsjekt.Models.ViewModels.MatchListItemViewModel>
@{
    ViewData["Title"] = "Mine avtaler";
    var publicActor = ResourceVisibility.CanBrowseAll(User);
    var items = Model.OrderByDescending(m => m.CanRespond || m.CanComplete || m.CanDeliver).ThenByDescending(m => m.MatchedAt).ToList();
}
<section class="overview-page delivery-page">
    <header class="overview-heading"><div><p class="eyebrow">Koordinering</p><h1>@(publicActor ? "Mine forespørsler og avtaler" : "Forespørsler til meg")</h1><p class="page-intro">@(publicActor ? "Følg forespørselen fra bekreftet levering til mottak." : "Svar på forespørsler om dine ressurser og følg opp avtalte leveranser.")</p></div><div class="record-actions"><a asp-action="History" class="portal-button secondary">Historikk</a>@if (publicActor) { <a asp-controller="Need" asp-action="Overview" class="portal-button">Finn et behov</a> }</div></header>
    @if (TempData["DeliverySuccess"] is string success) { <p class="delivery-feedback" role="status">@success</p> }
    <partial name="_Filters" />
    <p role="status">Viser @items.Count av @ViewData["TotalMatches"] aktive forespørsler og avtaler.</p>
    @if (!items.Any()) { <div class="portal-card empty-state"><h2>Ingen forespørsler eller avtaler å vise</h2><p>Prøv andre filtre eller nullstill søket. @(publicActor ? "Du kan sende en forespørsel fra Finn ressurser på et av dine behov." : "Nye forespørsler vises her når noen velger en av dine ressurser.")</p></div> }
    @foreach (var item in items) { <partial name="_DeliveryCard" model="item" /> }
</section>
