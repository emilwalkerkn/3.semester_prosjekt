@model IEnumerable<SemesterProsjekt.Models.ViewModels.MatchListItemViewModel>
@{ ViewData["Title"] = "Leveringshistorikk"; }
<section class="overview-page delivery-page">
    <header class="overview-heading"><div><p class="eyebrow">Historikk</p><h1>Leveringshistorikk</h1><p class="page-intro">Fullførte, avslåtte og avbrutte forespørsler. Avtalte og leverte bestillinger ligger under Mine avtaler frem til de er fullført.</p></div><a asp-action="Overview" class="portal-button secondary">Til mine avtaler</a></header>
    @if (TempData["DeliverySuccess"] is string success) { <p class="delivery-feedback" role="status">@success</p> }
    <partial name="_Filters" />
    <p role="status">Viser @Model.Count() av @ViewData["TotalMatches"] avsluttede forespørsler og avtaler.</p>
    @if (!Model.Any()) { <div class="portal-card empty-state"><h2>Ingen avsluttede avtaler å vise</h2><p>Prøv andre filtre eller nullstill søket.</p></div> }
    @foreach (var item in Model) { <partial name="_DeliveryCard" model="item" /> }
</section>
