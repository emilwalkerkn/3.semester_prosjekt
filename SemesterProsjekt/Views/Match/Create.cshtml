@model SemesterProsjekt.Models.ViewModels.CreateMatchViewModel
@{ ViewData["Title"] = "Velg behov"; }
<section class="overview-page delivery-page"><header><h1>Hvilket behov skal dekkes?</h1><p>Velg et av dine aktive behov. Deretter finner du passende ressurser.</p></header>
<form asp-action="FindResources" method="get" class="portal-card delivery-summary"><div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div><div class="form-field"><label for="needId">Behov</label><select id="needId" name="needId" asp-items="Model.Needs" required><option value="">Velg behov</option></select></div><div class="record-actions"><button type="submit" class="portal-button">Finn ressurser</button><a asp-action="Overview" class="portal-button secondary">Avbryt</a></div></form></section>
