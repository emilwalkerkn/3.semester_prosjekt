@*
    Dette er registreringssiden til Kriseportal.

    Her kan brukeren:
    - Opprette en ny konto
    - Skrive inn kontaktinformasjon
    - Registrere seg som ressurseier
    - Lage et passord
    - Gå tilbake til den offentlige forsiden
*@

@using SemesterProsjekt.Models
@model SemesterProsjekt.Models.ViewModels.RegisterViewModel

@{
    // Siden bruker ikke den vanlige layouten.
    Layout = null;
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />

    @* Gjør at siden fungerer bra på mobil. *@
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Opprett konto – Kriseportal</title>

    @* Henter Bootstrap og vår egen CSS. *@
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="login-page login-page-branded">

    @* Hovedinnholdet på siden. *@
    <main class="login-shell">

        @* Samme logo og blåfarge som innloggingen gir et gjenkjennelig oppsett. *@
        <section class="login-intro" aria-labelledby="register-brand-heading">
            @* Lenken går direkte til forsiden uten å sende inn registreringsskjemaet. *@
            <a asp-controller="Home" asp-action="Forside" class="login-back-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M19 12H5m7-7-7 7 7 7" />
                </svg>
                <span>Tilbake til forsiden</span>
            </a>

            <div class="login-brand-content">
                @* Den felles pin-logoen får sin lyse variant fra CSS. *@
                <div class="login-brand">
                    <partial name="_PortalPin" />
                    <div class="login-brand-wordmark">
                        <h1 id="register-brand-heading" class="login-brand-name">Krise<span>portal</span></h1>
                        <p class="login-brand-tagline">Registrer behov · Del ressurser</p>
                    </div>
                </div>

                <p class="login-brand-description">
                    Opprett en konto for å registrere og følge opp det du kan bidra med.
                </p>
            </div>
        </section>

        @* Boksen som inneholder registreringsskjemaet. *@
        <section class="login-card login-card-wide"
                 aria-labelledby="register-heading">

            <h2 id="register-heading">Opprett konto</h2>

            <p>
                Kontaktopplysningene kan endres senere
                under Innstillinger.
            </p>

            @*
                Skjemaet sender opplysningene til Register
                når brukeren trykker på knappen.
            *@
            <form asp-action="Register"
                  method="post"
                  class="login-form registration-form">

                @*
                    Lagrer siden brukeren skal sendes til
                    etter registrering.
                *@
                <input asp-for="ReturnUrl"
                       type="hidden" />

                @* Viser vanlige feilmeldinger fra registreringen. *@
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>

                @* Samler feltene i et rutenett. *@
                <div class="form-grid">

                    @* Felt for fornavn. *@
                    <div class="form-field">
                        <label asp-for="FirstName">
                            Fornavn
                        </label>

                        <input asp-for="FirstName"
                               autocomplete="given-name" />

                        <span asp-validation-for="FirstName"></span>
                    </div>

                    @* Felt for etternavn. *@
                    <div class="form-field">
                        <label asp-for="LastName">
                            Etternavn
                        </label>

                        <input asp-for="LastName"
                               autocomplete="family-name" />

                        <span asp-validation-for="LastName"></span>
                    </div>

                    @* Felt for e-postadresse. *@
                    <div class="form-field form-field-full">
                        <label asp-for="Email">
                            E-postadresse
                        </label>

                        <input asp-for="Email"
                               autocomplete="email"
                               placeholder="navn@eksempel.no" />

                        <span asp-validation-for="Email"></span>
                    </div>

                    @*
                        Brukeren velger hvilken rolle kontoen skal ha.
                        AppRoles inneholder navnene på rollene.
                    *@
                    <div class="form-field form-field-full">
                        <label asp-for="Role">
                            Jeg registrerer meg som
                        </label>

                        <input asp-for="Role" type="hidden"
                               value="@AppRoles.ResourceOwner" />

                        <p>Du registrerer deg som ressurseier.</p>

                        <span asp-validation-for="Role"></span>
                    </div>

                    @* Felt for å lage et passord. *@
                    <div class="form-field form-field-full">
                        <label asp-for="Password">
                            Passord
                        </label>

                        <input asp-for="Password"
                               autocomplete="new-password" />

                        <small>
                            Minst 8 tegn, med minst én stor bokstav,
                            én liten bokstav og ett tall.
                        </small>

                        <span asp-validation-for="Password"></span>
                    </div>

                    @*
                        Brukeren skriver inn passordet på nytt.
                        Dette sjekker at passordet er skrevet riktig.
                    *@
                    <div class="form-field form-field-full">
                        <label asp-for="ConfirmPassword">
                            Gjenta passord
                        </label>

                        <input asp-for="ConfirmPassword"
                               autocomplete="new-password" />

                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>

                @* Knappen sender inn registreringsskjemaet. *@
                <button type="submit">
                    Opprett konto
                </button>
            </form>

            <p class="login-switch">
                Har du allerede konto?

                @*
                    Sender brukeren til innloggingssiden.
                    ReturnUrl blir sendt videre.
                *@
                <a asp-action="Login"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Logg inn
                </a>
            </p>
        </section>
    </main>

    @*
        Henter skript som gjør at feilmeldinger
        kan vises før skjemaet sendes inn.
    *@
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
