@using SemesterProsjekt.Models
@model SemesterProsjekt.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Opprett konto – Kriseportal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
<main class="login-shell">
    <section class="login-intro">
        <div class="portal-brand">
            <span class="portal-brand-mark">K</span>
            <span>Kriseportal</span>
        </div>
        <h1>Bidra med behov eller ressurser når det trengs.</h1>
        <p>Opprett en konto for å registrere og følge opp det du kan bidra med.</p>
    </section>

    <section class="login-card login-card-wide" aria-labelledby="register-heading">
        <h2 id="register-heading">Opprett konto</h2>
        <p>Kontaktopplysningene kan endres senere under Innstillinger.</p>

        <form asp-action="Register" method="post" class="login-form registration-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-grid">
                <div class="form-field">
                    <label asp-for="FirstName">Fornavn</label>
                    <input asp-for="FirstName" autocomplete="given-name" />
                    <span asp-validation-for="FirstName"></span>
                </div>

                <div class="form-field">
                    <label asp-for="LastName">Etternavn</label>
                    <input asp-for="LastName" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Email">E-postadresse</label>
                    <input asp-for="Email" autocomplete="email" placeholder="navn@eksempel.no" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Role">Jeg registrerer meg som</label>
                    <select asp-for="Role">
                        <option value="@AppRoles.NeedsActor">Behovsaktør</option>
                        <option value="@AppRoles.ResourceOwner">Ressurseier</option>
                    </select>
                    <span asp-validation-for="Role"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="Password">Passord</label>
                    <input asp-for="Password" autocomplete="new-password" />
                    <small>Minst 8 tegn, med minst én stor bokstav, én liten bokstav og ett tall.</small>
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="form-field form-field-full">
                    <label asp-for="ConfirmPassword">Gjenta passord</label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>

            <button type="submit">Opprett konto</button>
        </form>

        <p class="login-switch">
            Har du allerede konto?
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Logg inn</a>
        </p>
    </section>
</main>

<partial name="_ValidationScriptsPartial" />
</body>
</html>
