@*
    Dette er siden som vises når en bruker
    prøver å åpne en side uten riktig tilgang.

    Siden:
    - Forklarer hvorfor tilgangen ble avvist
    - Gir brukeren en lenke tilbake til forsiden
*@

@{
    // Angir tittelen til siden.
    ViewData["Title"] = "Ingen tilgang";
}

<h1>Ingen tilgang</h1>

@* Forklarer hvorfor brukeren ikke får åpne siden. *@
<p>
    Du har ikke rollen som kreves for å åpne denne siden.
</p>

@*
    Lager en lenke til Index-handlingen
    i HomeController.
*@
<a asp-controller="Home"
   asp-action="Index"
   class="btn btn-primary">
    Til forsiden
</a>