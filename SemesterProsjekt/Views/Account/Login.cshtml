@model SemesterProsjekt.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logg inn – Kriseportal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
<main class="login-shell">
    <section class="login-intro">
        <div class="portal-brand">
            <span class="portal-brand-mark">K</span>
            <span>Kriseportal</span>
        </div>
        <h1>Koordiner behov og ressurser med oversikt.</h1>
        <p>Logg inn for å registrere behov, tilby ressurser og følge opp saker.</p>
    </section>

    <section class="login-card" aria-labelledby="login-heading">
        <h2 id="login-heading">Velkommen tilbake</h2>
        <p>Logg inn med e-post og passord.</p>

        <form asp-action="Login" method="post" class="login-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-field">
                <label asp-for="Email">E-postadresse</label>
                <input asp-for="Email" autocomplete="email" placeholder="Skriv inn e-postadressen din" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="form-field">
                <label asp-for="Password">Passord</label>
                <input asp-for="Password" autocomplete="current-password" placeholder="Skriv inn passord" />
                <span asp-validation-for="Password"></span>
            </div>

            <label class="login-remember">
                <input asp-for="RememberMe" />
                <span>Husk meg på denne enheten</span>
            </label>

            <button type="submit">Logg inn</button>
        </form>

        <p class="login-switch">
            Har du ikke konto?
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Opprett konto</a>
        </p>
    </section>
</main>

<partial name="_ValidationScriptsPartial" />
</body>
</html>
