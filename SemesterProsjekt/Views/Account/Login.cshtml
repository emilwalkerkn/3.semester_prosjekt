@*
    Dette er innloggingssiden til Kriseportal.

    Her kan brukeren:
    - Logge inn med e-post og passord
    - Velge «Husk meg»
    - Gå til registreringssiden
    - Gå tilbake til den offentlige forsiden
*@

@model SemesterProsjekt.Models.ViewModels.LoginViewModel

@{
    // Siden bruker ikke den vanlige layouten.
    Layout = null;
}

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />

    @* Gjør at siden fungerer bra på mobil. *@
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Logg inn – Kriseportal</title>

    @* Henter Bootstrap og vår egen CSS. *@
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="login-page login-page-branded">

    @* Hovedinnholdet på siden. *@
    <main class="login-shell">

        @* Logo og informasjon vises på portalens vanlige blå bakgrunn. *@
        <section class="login-intro" aria-labelledby="login-brand-heading">
            @* En vanlig lenke går til forsiden uavhengig av nettleserhistorikken. *@
            <a asp-controller="Home" asp-action="Forside" class="login-back-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M19 12H5m7-7-7 7 7 7" />
                </svg>
                <span>Tilbake til forsiden</span>
            </a>

            <div class="login-brand-content">
                @* Samme pin-symbol som på forsiden, med lyse farger fra CSS. *@
                <div class="login-brand">
                    <partial name="_PortalPin" />
                    <div class="login-brand-wordmark">
                        <h1 id="login-brand-heading" class="login-brand-name">Krise<span>portal</span></h1>
                        <p class="login-brand-tagline">Registrer behov · Del ressurser</p>
                    </div>
                </div>

                <p class="login-brand-description">
                    Logg inn for å se behov, tilby ressurser og følge opp saker.
                </p>
            </div>
        </section>

        @* Boksen som inneholder innloggingsskjemaet. *@
        <section class="login-card"
                 aria-labelledby="login-heading">

            <h2 id="login-heading">Velkommen tilbake</h2>
            <p>Logg inn med e-post og passord.</p>

            @*
                Skjemaet sender opplysningene til Login
                når brukeren trykker på knappen.
            *@
            <form asp-action="Login"
                  method="post"
                  class="login-form">

                @*
                    Lagrer siden brukeren skal sendes til
                    etter innlogging.
                *@
                <input asp-for="ReturnUrl"
                       type="hidden" />

                @* Viser vanlige feilmeldinger fra innloggingen. *@
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>

                @* Felt for e-postadresse. *@
                <div class="form-field">
                    <label asp-for="Email">
                        E-postadresse
                    </label>

                    <input asp-for="Email"
                           autocomplete="email"
                           placeholder="Skriv inn e-postadressen din"
                           autofocus />

                    @* Viser feil hvis e-postadressen ikke er gyldig. *@
                    <span asp-validation-for="Email"></span>
                </div>

                @* Felt for passord. *@
                <div class="form-field">
                    <label asp-for="Password">
                        Passord
                    </label>

                    <input asp-for="Password"
                           autocomplete="current-password"
                           placeholder="Skriv inn passord" />

                    @* Viser feil hvis passordet ikke er gyldig. *@
                    <span asp-validation-for="Password"></span>
                </div>

                @*
                    Brukeren kan velge om innloggingen
                    skal huskes på enheten.
                *@
                <label class="login-remember">
                    <input asp-for="RememberMe" />
                    <span>Husk meg på denne enheten</span>
                </label>

                @* Knappen sender inn skjemaet. *@
                <button type="submit">
                    Logg inn
                </button>
            </form>
            
            <p class="login-switch">
                Har du ikke konto?

                @* Sender brukeren til registreringssiden. *@
                <a asp-action="Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Opprett konto
                </a>
            </p>
        </section>
    </main>

    @*
        Henter skript som gjør at feilmeldinger
        kan vises før skjemaet sendes inn.
    *@
    <partial name="_ValidationScriptsPartial" />
    </body>
</html>
