
@model List<SemesterProsjekt.Models.Organization>

@{
    ViewData["Title"] = "Godkjente organisasjoner";
}

<div class="container mt-4">
    <h1>Godkjente organisasjoner</h1>

    <p>
        Her kan Heimevernet utpeke en administrator
        for hver godkjente organisasjon.
    </p>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">
            @success
        </div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">
            @error
        </div>
    }

    @if (!Model.Any())
    {
        <p>Ingen godkjente organisasjoner finnes.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Organisasjon</th>
                    <th>Status</th>
                    <th>Utpek administrator</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var organization in Model)
                {
                    <tr>
                        <td>@organization.Name</td>
                        <td>@organization.Status</td>
                        <td>
                            <form asp-controller="OrganizationApproval"
                                  asp-action="AssignOrganizationAdmin"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="organizationId"
                                       value="@organization.OrganizationId" />

                                <input type="email"
                                       name="email"
                                       class="form-control mb-2"
                                       placeholder="Brukerens e-post"
                                       required />

                                <button type="submit"
                                        class="btn btn-primary btn-sm"
                                        onclick="return confirm('Vil du gi denne brukeren administratorrettigheter?');">
                                    Utpek administrator
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
