@model SemesterProsjekt.Models.NeedViewModel
@{
   
    ViewData["Title"] = "Behov registrert";

}

<div class="text-center">

    <h1>Behov registrert</h1>

    <div class="mt-4">

        <p><strong>Type behov:</strong> @Model.Type</p>
        <p><strong>Beskrivelse:</strong> @Model.Description</p>
        <p><strong>Sted:</strong> @Model.Location</p>
        <p><strong>Latitude:</strong> @Model.Latitude</p>
        <p><strong>Longitude:</strong> @Model.Longitude</p>
    </div>

    <a asp-controller="Home"
       asp-action="Need"
       class="btn btn-primary mt-3">
        Registrer et nytt behov
    </a>
</div>

