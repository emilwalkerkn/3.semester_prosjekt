@model SemesterProsjekt.Models.NeedViewModel

@{
    ViewData["Title"] = "Behov registert";
}

<div class="text-center">

    <h1>behov registrert</h1>

    <div class="mt-4">

        <p> Type behov: @Model.Type</p>
        <p> Beskrivelse: @Model.Description</p>
        <p> Sted: @Model.Location</p>
    </div>

    <a asp-controller="Home"
        asp-action="Need"
        class="btn btn-primary mt-3">
        Registrer et nytt behov
    </a>
</div>

