@model SemesterProsjekt.Models.ResourceViewModel

@{
    ViewData["Title"] = "Registrer ressurs";
}
<div class="need-container">
    
    <h1>Registrer ressurs</h1>
    
    @if (ViewData["Message"] != null)
    {
        <p>@ViewData["Message"]</p>
    }

    <form method="post" class="need-form">
        <div>
            <label>Type ressurs</label>
            <input asp-for="Type"/>
        </div>

        <div>
            <label>Beskrivelse</label>
            <input asp-for="Description"/>
        </div>

        <div>
            <label>Sted</label>
            <input asp-for="Location"/>
        </div>

        <p>Valgt posisjon fra kartet:</p>
        <div>
            <label>Latitude</label>
            <input asp-for="Latitude" readonly/>
        </div>

        <div>
            <label>Longitude</label>
            <input asp-for="Longitude" readonly/>
        </div>

        <button type="submit">Registrer ressurs</button>
        
    </form>
    <h2>Velg sted på kartet</h2>
    
    <div id="map"></div>
    
</div>
@section Scripts {
    <script>

        // Oppretter Leaflet-kartet og setter startposisjonen
        // til Kristiansand.
        
        var map = L.map('map').setView([58.1467, 7.9956], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var marker;

        // Når brukeren klikker på kartet,
        // lagres den valgte posisjonen som latitude og longitude.

        map.on('click', function (e) {

            // Fjerner den forrige markøren slik at bare
            // den sist valgte posisjonen vises.
            if (marker) {
                map.removeLayer(marker);
            }

            marker = L.marker(e.latlng).addTo(map)
                .bindPopup(
                    "Valgt posisjon<br>" +
                    "Latitude: " + e.latlng.lat.toFixed(6) + "<br>" +
                    "Longitude: " + e.latlng.lng.toFixed(6)
                )
                .openPopup();


            // Fyller ut latitude og longitude i skjemaet
            // slik at koordinatene sendes videre ved POST.
            document.getElementById('Latitude').value = e.latlng.lat.toString();
            document.getElementById('Longitude').value = e.latlng.lng.toString();
        });
    </script>
}



