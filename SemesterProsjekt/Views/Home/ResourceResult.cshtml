@model SemesterProsjekt.Models.ResourceViewModel

@{
    ViewData["Title"] = "Ressurs registrert";
}

<div class="text-center">
    
    <h1>Ressurs registrert</h1>
    
    <div class="mt-4">
        
        <p><strong>Type ressurs: </strong> @Model.Type</p>
        <p><strong>Beskrivelse: </strong> @Model.Description</p>
        <p><strong>Sted: </strong> @Model.Location</p>
        <p><strong>Latitude: </strong> @Model.Latitude</p>
        <p><strong>Longitude: </strong> @Model.Longitude</p>
    </div>
    
    <a asp-controller="Home"
       asp-action="Resource"
       class="btn btn-primary mt-3">
        Registrer en ny ressurs
    </a>
    
</div>

