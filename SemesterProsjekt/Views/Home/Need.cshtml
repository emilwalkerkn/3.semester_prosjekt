@model SemesterProsjekt.Models.NeedViewModel

@{
    ViewData["Title"] = "Registrer behov";
}
<div class="need-container">

    <h1>Registrer behov</h1>

    @if (ViewData["Message"] != null)
    {
        <p>@ViewData["Message"]</p>
    }

    <form method="post" class="need-form">

        <div>
            <label>Type behov</label>
            <input asp-for="Type" />
        </div>

        <div>
            <label>Beskrivelse</label>
            <input asp-for="Description" />
        </div>

        <div>
            <label>Sted</label>
            <input asp-for="Location" />
        </div>
    
        <p>Valgt posisjon fra kartet:</p>
        <div>
        
            <label>Latitude</label>
            <input asp-for="Latitude" readonly/>
        </div>

        <div>
            <label>Longitude</label>
            <input asp-for="Longitude" readonly />
        </div>
        
        <input asp-for="GeometryType" type="hidden" id="GeometryType" />
        
        <input asp-for="GeometryData" type="hidden" id="GeometryData" />

        <button type="submit" class="need-button">Registrer behov</button>

    </form>

    <h2>Velg sted på kartet</h2>

    <div id="map"></div>

</div>


@section Scripts {
    <script>

        // Oppretter Leaflet-kartet og setter startposisjonen
        // til Kristiansand.
        var map = L.map('map').setView([58.1467, 7.9956], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        // Holder objektene som brukeren tegner på kartet.
        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        // Legger til tegneverktøy for markør og linje.
        var drawControl = new L.Control.Draw({
            draw: {
                polygon: false,
                polyline: true,
                circle: false,
                rectangle: false,
                marker: true
            },
            edit: {
                featureGroup: drawnItems,
                remove: true
            },
});

        map.addControl(drawControl);

        // Kjøres når brukeren tegner et nytt objekt på kartet.
        map.on('draw:created', function (e) {
            var layer = e.layer;

            // Legger objektet til kartet.
            drawnItems.addLayer(layer);

            // Lagrer hvilken type objekt som ble tegnet.
            document.getElementById('GeometryType').value = e.layerType;

            // Hvis brukeren tegner en markør, lagres koordinatene.
            if (e.layerType === 'marker') {
                var latlng = layer.getLatLng();

                document.getElementById('Latitude').value = latlng.lat;
                document.getElementById('Longitude').value = latlng.lng;
            }

            // Hvis brukeren tegner en linje, lagres hele linjen som GeoJSON.
            if (e.layerType === 'polyline') {
                var geoJson = layer.toGeoJSON();

                document.getElementById('GeometryData').value =
                    JSON.stringify(geoJson);
            }
});
       
    </script>
}
