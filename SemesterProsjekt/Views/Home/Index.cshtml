@model SemesterProsjekt.Models.DashboardViewModel

@{
    ViewData["Title"] = "Oversikt for offentlig aktør";
}

<section>
    <h1>Oversikt for offentlig aktør</h1>
    <p class="page-intro">Registrer behov, se tilgjengelige ressurser og følg opp hastesaker.</p>

    <a asp-controller="Need"
       asp-action="Create"
       class="portal-button">
        <span aria-hidden="true">+</span> Registrer behov
    </a>

    <a asp-controller="Resource"
       asp-action="Create"
       class="portal-button secondary">
        Registrer ressurs
    </a>
</section>

<div class="stat-grid">
    <div class="portal-card stat-card"><p>Mine åpne behov</p><strong>@Model.TotalNeeds</strong></div>
    <div class="portal-card stat-card"><p>Tilgjengelige ressurser</p><strong>@Model.TotalResources</strong></div>
    <div class="portal-card stat-card"><p>Saker til oppfølging</p><strong>@(Model.TotalNeeds + Model.TotalResources)</strong></div>
</div>

<section class="portal-card section-card">
    <h2>Siste registreringer</h2>
    <ul class="summary-list">
        @foreach (var need in Model.RecentNeeds)
        { <li><a asp-controller="Need" asp-action="Details" asp-route-id="@need.NeedId">@need.Title</a><span class="status new">@need.Status</span><a asp-controller="Need" asp-action="Details" asp-route-id="@need.NeedId">Se detaljer</a></li> }
        @foreach (var resource in Model.RecentResources)
        { <li><a asp-controller="Resource" asp-action="Details" asp-route-id="@resource.ResourceId">@resource.Title</a><span class="status available">@resource.Status</span><a asp-controller="Resource" asp-action="Details" asp-route-id="@resource.ResourceId">Se detaljer</a></li> }
    </ul>
    @if (!Model.RecentNeeds.Any() && !Model.RecentResources.Any()) { <p class="empty-state">Ingen registreringer ennå.</p> }
</section>
